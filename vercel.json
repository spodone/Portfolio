{
  "redirects": [
    { "source": "/white-label-openware", "destination": "/white-label-opendax", "permanent": true },
    { "source": "/white-label-openware.html", "destination": "/white-label-opendax", "permanent": true }
  ],
  "rewrites": [
    { "source": "/trady", "destination": "/trady.html" },
    { "source": "/ouinex", "destination": "/ouinex.html" },
    { "source": "/kyb-fuib", "destination": "/kyb-fuib.html" },
    { "source": "/token-staking-dappradar", "destination": "/token-staking-dappradar.html" },
    { "source": "/rankings-dappradar", "destination": "/rankings-dappradar.html" },
    { "source": "/white-label-opendax", "destination": "/white-label-opendax.html" },
    { "source": "/design-system-dappradar", "destination": "/design-system-dappradar.html" },
    { "source": "/kyc-drop-off", "destination": "/kyc-drop-off.html" },
    { "source": "/work", "destination": "/work.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
